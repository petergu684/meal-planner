# Meal Planner Configuration
# Copy this to .env and fill in your values.

# --- Core ---

# Data directory — where the database, uploads, and backups are stored.
# Default: ./data (relative to server.py)
MEAL_PLANNER_DATA=./data

# Server port. Default: 8091
MEAL_PLANNER_PORT=8091

# Secret admin URL path. The admin SPA is served here; pick something hard to
# guess (this is the only gate protecting your dish library and planner).
# Default: /admin   — CHANGE THIS before exposing the server.
MEAL_PLANNER_ADMIN_PATH=/admin-change-me

# --- Daily reminder (optional) ---
# Used by remind.sh, which is intended to run from a systemd timer.

# Base URL of the running server (so the reminder script can fetch the message).
# Default: http://localhost:8091
MEAL_PLANNER_URL=http://localhost:8091

# Discord bot credentials for the daily "tomorrow's meals" reminder.
# Create a bot at https://discord.com/developers/applications, invite it to
# your server with the "Send Messages" permission, and copy the token + the
# target channel's ID (Discord → Settings → Advanced → Developer Mode → right
# click channel → Copy Channel ID).
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
